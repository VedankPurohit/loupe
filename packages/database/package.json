{
  "name": "@workspace/database",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "drizzle-orm": "0.44.3",
    "postgres": "3.4.7"
  },
  "devDependencies": {
    "@types/node": "24.0.15",
    "drizzle-kit": "0.31.4",
    "tsx": "4.20.3"
  }
}
