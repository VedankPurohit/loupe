{
  "name": "@workspace/relay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "coding-agent-relay": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && esbuild src/cli.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/cli.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@workspace/agent-adapter": "link:../agent-adapter",
    "@workspace/contracts": "link:../contracts",
    "@types/node": "24.0.15",
    "esbuild": "0.25.12",
    "vitest": "3.2.4"
  }
}
