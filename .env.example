# Native development central store. Create it with: createdb agent_observer_dev
DATABASE_URL=postgresql://localhost/agent_observer_dev
HOST=127.0.0.1
PORT=3000

# Set BOOTSTRAP_CODE only for deterministic automation. It must start with
# bootstrap_ and contain at least 43 URL-safe characters after the prefix.

# Optional administrative PostgreSQL connection for disposable test databases:
# TEST_DATABASE_ADMIN_URL=postgresql://localhost/postgres
