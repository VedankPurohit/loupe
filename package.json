{
  "name": "coding-agent-observability-workspace",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.22.3 <23"
  },
  "scripts": {
    "build": "pnpm -r build",
    "build:vercel": "node scripts/build-vercel-frontend.mjs",
    "predev": "pnpm --filter @workspace/contracts build && pnpm --filter @workspace/database build",
    "dev": "concurrently -n server,web -c blue,magenta \"pnpm --filter @workspace/server dev\" \"pnpm --filter @workspace/web dev\"",
    "prototype:console": "pnpm --filter @workspace/prototype-console dev",
    "prototype:map": "pnpm --filter @workspace/prototype-map dev",
    "prototype:notebook": "pnpm --filter @workspace/prototype-notebook dev",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @workspace/agent-adapter test && pnpm --filter @workspace/server test && pnpm --filter @workspace/relay test",
    "test:compose": "node scripts/compose-smoke.mjs",
    "test:deployment-config": "node --test scripts/deployment-config.test.mjs",
    "test:e2e": "playwright test",
    "db:generate": "pnpm --filter @workspace/database db:generate",
    "db:migrate": "pnpm --filter @workspace/database db:migrate"
  },
  "devDependencies": {
    "@playwright/test": "1.54.1",
    "concurrently": "9.2.0",
    "postgres": "3.4.7",
    "tsx": "4.20.3",
    "typescript": "5.8.3"
  }
}
