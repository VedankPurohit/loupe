{
  "name": "coding-agent-observability-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.22.3 <23"
  },
  "scripts": {
    "build": "pnpm -r build",
    "predev": "pnpm --filter @workspace/contracts build && pnpm --filter @workspace/database build",
    "dev": "concurrently -n server,web -c blue,magenta \"pnpm --filter @workspace/server dev\" \"pnpm --filter @workspace/web dev\"",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @workspace/server test",
    "test:e2e": "playwright test",
    "db:generate": "pnpm --filter @workspace/database db:generate",
    "db:migrate": "pnpm --filter @workspace/database db:migrate"
  },
  "devDependencies": {
    "@playwright/test": "1.54.1",
    "concurrently": "9.2.0",
    "postgres": "3.4.7",
    "tsx": "4.20.3",
    "typescript": "5.8.3"
  }
}
