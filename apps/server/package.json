{
  "name": "@workspace/server",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "pretest": "pnpm --filter @workspace/contracts build && pnpm --filter @workspace/database build && pnpm --filter @workspace/relay build && pnpm run build",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/cookie": "11.0.2",
    "@fastify/swagger": "9.5.1",
    "@workspace/contracts": "workspace:*",
    "@workspace/database": "workspace:*",
    "drizzle-orm": "0.44.3",
    "fastify": "5.4.0",
    "fastify-type-provider-zod": "5.0.3",
    "postgres": "3.4.7",
    "zod": "4.0.10"
  },
  "devDependencies": {
    "@workspace/relay": "workspace:*",
    "@types/node": "24.0.15",
    "tsx": "4.20.3",
    "vitest": "3.2.4"
  }
}
